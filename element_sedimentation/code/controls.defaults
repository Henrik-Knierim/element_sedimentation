! anchor = 'phase_separation_mixing_use_brunt = .true.'


! element sedimentation
! =====================

      ! Sedimentation ("rain") of a chemical species that becomes immiscible in the
      ! surrounding mixture, e.g. helium rain in giant planets. This is an extension
      ! and not part of the official MESA release.

      ! The sedimenting species is transported by a conservative advection-diffusion
      ! equation in the Lagrangian mass coordinate: convective mixing (MESA's ``D_mix``)
      ! acts as diffusion and rain as advection with velocity
      ! ``element_sedimentation_velocity``. In every cell whose (P, T) lie inside the
      ! immiscibility region of the phase diagram only the part of the species above
      ! the He-poor limit rains out, and inflow stops once the cell reaches the He-rich
      ! limit, so a species-rich layer grows upward from the centre. All other species
      ! are moved by the displaced counter-flow, which keeps the mass fractions summing
      ! to one and conserves the total mass of every species.

      ! do_element_sedimentation
      ! ~~~~~~~~~~~~~~~~~~~~~~~~

      ! Turn on element sedimentation. Requires ``element_sedimentation_phase_diagram``.

      ! ::

    do_element_sedimentation = .false.

      ! element_sedimentation_method
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! Algorithm for the mass transfer. The first three share the same floors (He-poor
      ! limits), caps (He-rich limits), counter-flow of the other species, damping,
      ! overturn, energy terms, checks and mixing takeover; they differ in how the
      ! transport is solved:

      ! + ``'advection_diffusion_rain'`` : implicit advection-diffusion solver with a finite
      !   rain velocity, to the steady state of the step or for the physical time
      !   (recommended; the only one with a time scale).
      ! + ``'instant_rain'`` : the same steady state in the limit of infinitely fast rain,
      !   computed directly in one sweep (every immiscible cell drains to its He-poor
      !   limit, the drained helium fills the cells below up to their limits, fully
      !   miscible cells take the rest, and a layer at the He-rich limit grows upward
      !   from the centre when the helium cannot go deeper); no iteration, no velocity.
      !   The fast backup.
      ! + ``'bottom_up_rain'`` : ``'instant_rain'`` repeated with the miscibility limits
      !   re-evaluated from the new composition after every transfer, until a transfer
      !   moves nothing (at most ``element_sedimentation_transfer_rounds`` rounds). The
      !   limits depend on the composition only through the other species, so this
      !   differs from ``'instant_rain'`` only where their ratios vary.
      ! + ``'instant_rain_legacy'``, ``'bottom_up_rain_legacy'`` : the old implementations
      !   of the two, kept for comparison (``element_sedimentation_legacy.f90``): one
      !   global transfer with heuristics for the deposit region, or the same repeated
      !   for every cell range k:nz from the centre outward. They use neither the caps,
      !   nor the overturn, nor the mixing takeover.

      ! ::

    element_sedimentation_method = 'advection_diffusion_rain'

      ! element_sedimentation_transfer_rounds
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! Maximum number of transfer rounds of ``'bottom_up_rain'`` (each round re-evaluates
      ! the miscibility limits from the composition the previous round left). Rounds stop
      ! early when a transfer moves less than 1d-12 in mass fraction.

      ! ::

    element_sedimentation_transfer_rounds = 5

      ! element_sedimentation_chemical_species
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! Isotope that sediments (must be in the nuclear net).

      ! ::

    element_sedimentation_chemical_species = 'he4'

      ! element_sedimentation_partner_species
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! Second component of the two-component phase diagram (must be in the nuclear net).
      ! The phase diagram is tabulated in the number fraction of the sedimenting species
      ! within this pair; all other species are carried along without entering it.

      ! ::

    element_sedimentation_partner_species = 'h1'

      ! element_sedimentation_phase_diagram
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! Path to the phase diagram file (CSV). One header line, then rows
      ! ``y_lo, y_hi, T [K], P [Mbar]`` with ``y_lo`` the He-poor and ``y_hi`` the He-rich
      ! number-fraction limit of the sedimenting species in the two-component subsystem.
      ! Rows are grouped in blocks of constant P with T strictly increasing inside a
      ! block and P strictly increasing between blocks.

      ! ::

    element_sedimentation_phase_diagram = ''

      ! element_sedimentation_phase_diagram_temperature_shift
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! Shift (K) added to the temperatures of the phase diagram, e.g. to account for
      ! uncertainties in the demixing temperature.

      ! ::

    element_sedimentation_phase_diagram_temperature_shift = 0d0

      ! element_sedimentation_extrapolate_phase_diagram
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! If true, the miscibility limits are extrapolated linearly in temperature above
      ! the tabulated range (and clamped to [0,1]); otherwise such cells are treated as
      ! miscible.

      ! ::

    element_sedimentation_extrapolate_phase_diagram = .false.

      ! element_sedimentation_velocity_method
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! How the sedimentation velocity of the droplets is determined.
      ! Only ``'constant'`` (``element_sedimentation_velocity`` everywhere) is implemented.

      ! ::

    element_sedimentation_velocity_method = 'constant'

      ! element_sedimentation_velocity
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! Sedimentation velocity of the droplets (cm/s). Positive values sink toward the
      ! centre. The carrier mass flow rate through a face is ``4 pi r^2 rho v``. Only
      ! ``'advection_diffusion_rain'`` uses it; the instant methods always let the species
      ! sink and ignore the value.

      ! ::

    element_sedimentation_velocity = 1d2

      ! element_sedimentation_D_mix_factor
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! Factor multiplying MESA's ``D_mix`` in the diffusive part of the transport.
      ! The conductance is built from ``D_mix`` exactly like MESA's ``sig``, but without
      ! ``mix_factor``, so the module mixes even if ``mix_factor = 0`` (a workaround that was
      ! needed before ``element_sedimentation_replace_mesa_mixing`` existed).

      ! ::

    element_sedimentation_D_mix_factor = 1d0

      ! element_sedimentation_cap_width
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! Absolute width (in mass fraction) of the ramp below the He-rich limit over which
      ! the inflow of rain into a cell is throttled to zero.

      ! ::

    element_sedimentation_cap_width = 1d-3

      ! element_sedimentation_solve_to_steady_state
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! If true, the transport is integrated to its steady state in every step
      ! (pseudo-transient continuation), i.e. rain and convective mixing are assumed to be
      ! fast compared to the evolution. If false, it is integrated for the physical time
      ! step ``dt`` only; the integration ends early once the profile is steady (the
      ! coefficients are frozen during the step), so for MESA time steps much longer than
      ! the rain and mixing timescales both settings give the same result.

      ! ::

    element_sedimentation_solve_to_steady_state = .true.

      ! element_sedimentation_steady_state_tolerance
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! The steady state is reached when the dimensionless residual
      ! ``max_k |dX_k| / dt * tau_max`` drops below this value (``tau_max`` is the longest
      ! face timescale of the problem). Smaller values follow slow modes further.

      ! ::

    element_sedimentation_steady_state_tolerance = 1d-8

      ! element_sedimentation_max_steps
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! Maximum number of implicit steps of the transport solver per MESA step.
      ! Exceeding it is an error (the MESA step is retried).

      ! ::

    element_sedimentation_max_steps = 1000

      ! element_sedimentation_advection_diffusion_time_step_factor
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! First (pseudo-)time step of the transport solver as a fraction of the shortest
      ! face timescale ``min_k dm_k / (sig_k + |w_k|)``. Later steps grow geometrically.

      ! ::

    element_sedimentation_advection_diffusion_time_step_factor = 0.5d0

      ! element_sedimentation_maximum_dXi_per_cell
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! Ceiling on the change of the mass fraction of the sedimenting species caused by rain
      ! in any cell in one MESA step, meant to keep MESA from failing when a lot of material
      ! rains out at once. The transport is also solved without rain (mixing only, same
      ! ``D_mix``); if rain changes some cell by more than this relative to that mixing-only
      ! state, the step is scaled down for all species,
      ! ``xa = xa_mix + f*(xa_rain - xa_mix)`` with ``f = limit/(largest change)``. In unmixed
      ! (e.g. radiative) cells ``xa_mix`` is the composition at the start of the step, so the
      ! ceiling applies there directly; mixed regions stay mixed. The scaled state conserves
      ! every species and sums to one; the remaining rain happens in the following steps.
      ! Negative values disable the limit.

      ! ::

    element_sedimentation_maximum_dXi_per_cell = -1d0

      ! element_sedimentation_retry_change_factor
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! When MESA retries a step (same model number, smaller time step) after the
      ! sedimenting species was transported, the steady-state result would be identical
      ! on every retry because it does not depend on the time step; the structure solver
      ! then fails again until the minimum time step is reached. If this factor is > 0,
      ! every retry of a model limits the largest change per cell of the whole step
      ! (rain and mixing together, relative to the composition at the start of the step)
      ! to this factor times the largest change applied in the previous attempt times
      ! the ratio of the new to the previous time step, compounding with each further
      ! retry; the composition is blended between the start and the result of the
      ! transport. The time-step ratio matters: the heating of the step is the energy
      ! of the composition change divided by ``dt``, so a limit that only halved the
      ! change while MESA halves ``dt`` would leave the heating rate unchanged, retry
      ! after retry. Unlike
      ! ``element_sedimentation_maximum_dXi_per_cell`` this is measured from the start of
      ! the step and not from the mixing-only state, because MESA could not converge with
      ! the previous attempt and the mixing-only state can itself be a large change (the
      ! mixing coefficients of the start of the step may homogenize a helium ocean the
      ! previous attempt had just formed). The material that did not rain out in this
      ! step rains out in the following steps. A notice is printed whenever the limit is
      ! applied. Values <= 0 disable this.

      ! ::

    element_sedimentation_retry_change_factor = 0.5d0

      ! element_sedimentation_cell_threshold_for_precipitation
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! Minimum number of saturated cells (mass fraction of the sedimenting species at or
      ! above the He-poor limit) for rain to happen (at least one is always required).
      ! Cells left exactly at their limit by the previous step count, so the rain keeps
      ! going once it has started. Below the threshold the module still acts in mixing-only
      ! steps if ``element_sedimentation_act_on_mixing_contrast`` asks for it.

      ! ::

    element_sedimentation_cell_threshold_for_precipitation = 1

      ! element_sedimentation_suppress_mixing_in_immiscible_regions
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! If true, MESA's mixing coefficients (``D_mix`` and ``sig``) are set to zero on
      ! both faces of every cell that was inside the immiscibility gap before the
      ! transport, for the rest of the step. Also sets ``do_conv_premix = .false.``.
      ! Used by ``'advection_diffusion_rain'``, ``'instant_rain'`` and ``'bottom_up_rain'``,
      ! and only if ``element_sedimentation_replace_mesa_mixing = .false.`` (which switches
      ! off all of MESA's composition mixing in the steps in which the module acts). The
      ! legacy methods ignore it: ``'instant_rain_legacy'`` always sets ``D_mix = 0`` in the
      ! immiscible cells and switches off ``do_conv_premix``; ``'bottom_up_rain_legacy'``
      ! never changes the mixing.

      ! ::

    element_sedimentation_suppress_mixing_in_immiscible_regions = .false.

      ! element_sedimentation_replace_mesa_mixing
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! If true, the module replaces MESA's composition mixing in every step in which it
      ! acts: its transport already mixes all species with ``D_mix`` (to steady state, or for
      ! ``dt`` in time-accurate mode) together with the rain, so ``D_mix`` and ``sig`` are set
      ! to zero for the rest of that step (MESA recomputes them at the next step). In steps
      ! in which the module does not act (no saturated cell and, with
      ! ``element_sedimentation_act_on_mixing_contrast``, no mixed face with a composition
      ! contrast) MESA mixes as usual. This keeps MESA's mixing from undoing
      ! the rain, so ``mix_factor`` can stay at 1. Note that the profiles of such steps show
      ! ``D_mix = 0`` (``mixing_type`` is unchanged), and that in a steady-state solve all
      ! regions connected by ``D_mix > 0`` are homogenized regardless of how slow the mixing
      ! is (use ``element_sedimentation_solve_to_steady_state = .false.`` if slow mixing
      ! processes matter). If false, MESA's mixing is left alone (then set ``mix_factor = 0``
      ! or ``element_sedimentation_suppress_mixing_in_immiscible_regions``).

      ! ::

    element_sedimentation_replace_mesa_mixing = .true.

      ! element_sedimentation_overturn_unstable_layers
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! If true, layers that the transport leaves convectively unstable are mixed at once
      ! (``sedimentation_overturn.f90``). The rain is deposited below the immiscible region
      ! and spread with the mixing coefficients of the start of the step; where those are
      ! zero (a layer below the rain region that has become radiative because the helium
      ! gradient throttles the luminosity) the deposit sits as a heavier layer on top of
      ! lighter material. MESA's mixing coefficients are fixed for the step, so it could
      ! not mix the inversion away, and its convection treatment reacts to the inverted
      ! composition gradient with an inverted temperature gradient (``gradT = gradL < 0``)
      ! that pumps luminosity into the deposit and out of the core. Physically such a layer
      ! overturns on a dynamical timescale. Every run of cells whose faces are unstable by
      ! the Ledoux criterion, ``gradr > grada + B`` with ``B`` from the equation of state at
      ! the new composition (as in MESA's ``brunt.f90``), is therefore homogenized, every
      ! species mass-weighted, with the pool-adjacent-violators algorithm: blocks grow
      ! until the face above them is stable, e.g. down to the centre of an interior of
      ! uniform composition. ``gradr`` and ``grada`` are those of the start of the step.
      ! Faces that are only thermohaline-unstable (``gradr < grada + B``, ``B < 0``) are left
      ! to MESA. Used by ``'advection_diffusion_rain'``, ``'instant_rain'`` and
      ! ``'bottom_up_rain'`` (the legacy methods ignore it). The report line shows the
      ! number of faces and blocks mixed.

      ! ::

    element_sedimentation_overturn_unstable_layers = .true.

      ! element_sedimentation_act_on_mixing_contrast
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! If true, the module also acts in steps without saturated cells whenever some
      ! face with ``D_mix > 0`` separates cells whose mass fractions of the sedimenting
      ! species differ by more than ``element_sedimentation_mixing_contrast_tolerance``:
      ! it then runs its transport without rain (mixing only, with the passive species,
      ! the damping, the overturn and the energy terms) and switches MESA's mixing off for
      ! the step as usual. Reason: MESA's own mixing carries no enthalpy flux (every cell
      ! keeps its internal energy while its composition changes). After rain the
      ! species-poor envelope lies on the species-rich interior; when MESA's convection
      ! later reaches through that interface, the exchange of hydrogen-rich and
      ! helium-rich material is of the same kind as the rain, and with the partial
      ! enthalpy difference of the dense fluid (several kT/m_p) MESA's bookkeeping cools
      ! the cells that receive hydrogen (the core, by ~100 K per 0.3 % of helium) and
      ! heats the ones that receive helium. With this control every composition change
      ! of the species in a mixed region goes through the module and its energy terms.
      ! Used by ``'advection_diffusion_rain'``, ``'instant_rain'`` and ``'bottom_up_rain'``
      ! (the legacy methods ignore it). Note that in steady-state mode the
      ! module homogenizes every region connected by ``D_mix > 0`` at once; set it to
      ! false in models where slow mixing processes (thermohaline, rotational) of the
      ! species matter, or use ``element_sedimentation_solve_to_steady_state = .false.``.

      ! ::

    element_sedimentation_act_on_mixing_contrast = .true.

      ! element_sedimentation_mixing_contrast_tolerance
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! Difference of the mass fraction of the sedimenting species across a mixed face
      ! above which ``element_sedimentation_act_on_mixing_contrast`` makes the module act.

      ! ::

    element_sedimentation_mixing_contrast_tolerance = 1d-6

      ! element_sedimentation_heating
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! If true, ``eps_element_sedimentation`` is included as a heating term in the energy
      ! equation (both the ``dedt`` and the ``eps_grav`` form; like
      ! ``do_phase_separation_heating``). It consists of the change of the internal energy
      ! caused by the composition change at fixed (rho, T), which keeps every cell's
      ! internal energy fixed while its composition changes and so conserves the total
      ! energy (MESA's ``xa_start`` and ``energy_start`` are reset after this hook, so the
      ! composition term of ``eps_grav`` does not see the sedimentation and there is no
      ! double counting), plus, with ``element_sedimentation_include_enthalpy_flux``, the
      ! energy carried by the moved species. As for phase separation, the term is always
      ! part of MESA's total-energy bookkeeping, so switching it off makes the reported
      ! energy conservation error reflect the omitted heating and will trigger
      ! ``hard_limit_for_rel_error_in_energy_conservation`` retries unless that limit is
      ! relaxed; use ``.false.`` only for experiments.

      ! ::

    element_sedimentation_heating = .true.

      ! element_sedimentation_include_enthalpy_flux
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! If true, the species moved by the sedimentation carry their partial specific
      ! enthalpy, evaluated from the equation of state at fixed temperature and pressure
      ! (``sedimentation_energy.f90``). The divergence of this energy flux is added to
      ! ``eps_element_sedimentation``: a cell gains the enthalpy of what arrives and loses
      ! the enthalpy of what leaves. In the Lagrangian frame the sinking species is
      ! replaced by an equal mass of the others, so this term contains the buoyancy work
      ! of the sinking species (the gravitational energy dissipated by drag where it falls)
      ! and the heat carried by the exchange of hot material from below against cold
      ! material from above; the gravitational energy released by the contraction of the
      ! mass shells enters through the structure equations as usual. The term sums to zero
      ! over the star: it only redistributes energy. If false, every cell keeps its internal
      ! energy while its composition changes, as MESA does for element diffusion and phase
      ! separation; for helium rain that cools the helium-depleted envelope and heats the
      ! helium-enriched layers by the enthalpy difference of H and He per gram exchanged
      ! (9/8 kT/m_p for an ideal H2/He gas, 6-7 kT/m_p in the dense fluid at the rain
      ! region of a Jupiter-mass planet with the CMS equation of state), which cools the
      ! envelope by hundreds of K and lowers T_eff while rain is strong. With
      ! ``element_sedimentation_report`` the ratio of that difference to kT/m_p at the top
      ! and bottom of the rain region is printed every step.

      ! ::

    element_sedimentation_include_enthalpy_flux = .true.

      ! element_sedimentation_report
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! If true, print a summary line per step and one line per implicit step of the
      ! transport solver.

      ! ::

    element_sedimentation_report = .false.

